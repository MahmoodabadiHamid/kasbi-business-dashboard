# Copy to .env so the dashboard can read SQL Server directly. Never commit credentials.
SQL_SERVER=your-sql-server-host
SQL_DATABASE=TooranFramework
# Leave SQL_USERNAME and SQL_PASSWORD blank to use Windows Integrated Security.
SQL_USERNAME=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
